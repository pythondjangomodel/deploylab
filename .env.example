# Copy this file to .env for local reference only.
# Django does NOT read .env automatically in this project — these are
# the variables you will type into the Render dashboard's Environment
# tab. Keeping this file lets you see all of them in one place.

SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-app-name.onrender.com
DATABASE_URL=postgresql://user:password@host:5432/dbname
